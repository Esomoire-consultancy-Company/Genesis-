{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vsr:silk:schema:projection:r0.3",
  "title": "SILK Projection R0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_id",
    "projection_kind",
    "economic_fact_ref",
    "instruction_ref",
    "source_fingerprint",
    "provider_result_ref",
    "river_evidence_refs",
    "value",
    "finalized_at",
    "payload",
    "version"
  ],
  "properties": {
    "projection_id": {"type": "string", "minLength": 1},
    "projection_kind": {"type": "string", "enum": ["VSR", "EMPIRE"]},
    "economic_fact_ref": {"type": "string", "minLength": 1},
    "instruction_ref": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_result_ref": {"type": "string", "minLength": 1},
    "river_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "finalized_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "version": {"const": "R0.3"}
  },
  "allOf": [
    {
      "if": {"properties": {"projection_kind": {"const": "VSR"}}, "required": ["projection_kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participation_effect", "counterparty_ref", "programme_ref", "arc_refs"],
            "properties": {
              "participation_effect": {"const": "VALUE_TRANSFER"},
              "counterparty_ref": {"type": "string", "minLength": 1},
              "programme_ref": {"type": "string", "minLength": 1},
              "arc_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"projection_kind": {"const": "EMPIRE"}}, "required": ["projection_kind"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["financial_effect", "counterparty_ref", "obligation_ref"],
            "properties": {
              "financial_effect": {"const": "OUTFLOW"},
              "counterparty_ref": {"type": "string", "minLength": 1},
              "obligation_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
