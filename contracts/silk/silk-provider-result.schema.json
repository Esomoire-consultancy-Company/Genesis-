{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vsr:silk:schema:provider-result:r0.2",
  "title": "SILK Provider Result R0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_result_id",
    "instruction_ref",
    "provider_binding_ref",
    "warden_decision_ref",
    "execution_route_ref",
    "idempotency_key",
    "outcome",
    "value",
    "version"
  ],
  "properties": {
    "provider_result_id": {"type": "string", "minLength": 1},
    "instruction_ref": {"type": "string", "minLength": 1},
    "provider_binding_ref": {"type": "string", "minLength": 1},
    "warden_decision_ref": {"type": "string", "minLength": 1},
    "execution_route_ref": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "outcome": {
      "type": "string",
      "enum": ["ACCEPTED", "SETTLED", "REJECTED", "FAILED"]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$"
        },
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "accepted_at": {"type": "string", "format": "date-time"},
    "settled_at": {"type": "string", "format": "date-time"},
    "provider_receipt_ref": {"type": "string", "minLength": 1},
    "failure_code": {"type": "string", "minLength": 1},
    "failure_detail": {"type": "string", "minLength": 1},
    "version": {"const": "R0.2"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"enum": ["ACCEPTED", "SETTLED"]}}, "required": ["outcome"]},
      "then": {"required": ["accepted_at"]}
    },
    {
      "if": {"properties": {"outcome": {"const": "SETTLED"}}, "required": ["outcome"]},
      "then": {"required": ["settled_at", "provider_receipt_ref"]}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["REJECTED", "FAILED"]}}, "required": ["outcome"]},
      "then": {"required": ["failure_code"]}
    }
  ]
}
